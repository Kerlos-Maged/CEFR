# ---------------------------------------------------------------------------
# Coptic Heritage Platform — environment variables
#
# Copy this file to `.env.local` for local development and fill in real values.
# NEVER commit real values. `.env.local` is git-ignored.
#
# Variables prefixed with NEXT_PUBLIC_ are bundled into the browser and must
# never hold secrets. All other variables are server-only.
# ---------------------------------------------------------------------------

# --- Browser-safe (public) --------------------------------------------------
# Supabase project URL and anonymous/publishable key.
# Not required to run the Phase 2 skeleton; required from Phase 3 onward.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical public origin used to build permanent QR URLs (/o/{publicId}).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never exposed to the browser) ---------------------
# Service-role key: bypasses Row Level Security. Server-side use only.
# NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Salt used for privacy-preserving analytics session hashing; rotate periodically.
ANALYTICS_HASH_SALT=
# Set a different long random value for the scheduled retention endpoint.
ANALYTICS_RETENTION_CRON_SECRET=
